# Copy to .env.local (git-ignored) for local development, or configure
# these as build-time environment variables in each deployment environment
# (dev/staging/production) per 02_Project_Standards.md §4 — nothing
# sensitive belongs in source control. None of these values are secrets in
# the traditional sense (a public client SPA has no client secret — Entra
# authenticates the user, not the app), but they are still
# environment-specific and must not be hardcoded.
#
# None of the placeholder values below are real. DevOps/Chief Technical
# Architect to supply real per-environment values — see
# docs/WP-020-Real-Auth-And-Api-Integration-Decisions.md §1.

# Entra External ID application (client) ID for the APFlow.Web app registration.
VITE_ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Entra authority URL for this environment.
VITE_ENTRA_AUTHORITY=https://your-tenant.ciamlogin.com/your-tenant-id

# Redirect URI registered on the app registration for this environment.
# Optional — defaults to the page's own origin if unset.
VITE_ENTRA_REDIRECT_URI=http://localhost:5173

# The scope to request an access token for, exposed by APFlow.Api's own
# app registration.
VITE_API_SCOPE=api://00000000-0000-0000-0000-000000000000/access_as_user

# Base URL of APFlow.Api for this environment.
VITE_API_BASE_URL=https://localhost:5001
