<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>APFlow.Api</RootNamespace>
    <AssemblyName>APFlow.Api</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Built-in OpenAPI generation only (Microsoft.AspNetCore.OpenApi), per Project Standards §2
      ("prefer built-in .NET and Azure capabilities") and to match the existing local scaffold.
      No Swagger UI package: there is no interactive UI page without adding a third-party
      package (Swashbuckle/NSwag/Scalar). The raw document is served at /openapi/v1.json in
      Development. If an interactive UI is wanted, that is a separate approval decision -
      see WP-001 review notes.
    -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.18" />

    <!--
      Bug fix (WP-002 review): unlike Authorization, the JwtBearer authentication
      handler is NOT part of the ASP.NET Core shared framework in .NET 9 - it requires
      this explicit package reference. Microsoft-authored, ships as an official
      ASP.NET Core package - not a new third-party dependency.
    -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.18" />

    <!--
      Microsoft-authored EF Core health check extension (AddDbContextCheck), added
      WP-003 to wire the DB check that AddApiServices' own comment flagged as
      pending since WP-001 ("Dependency-specific checks... added here as their
      infrastructure registrations land" - AppDbContext landed in WP-003, this closes
      that gap).
    -->
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="9.0.18" />

    <!--
      Design-time only (dotnet ef database update). The CI/CD pipeline runs
      dotnet ef with the "project" flag pointed at APFlow.Infrastructure
      (where AppDbContext and its migrations live) and the "startup-project"
      flag pointed at APFlow.Api - the EF Core tools load design-time
      services from the STARTUP project, so it needs its own reference to
      this package even though Infrastructure already has one.
      Infrastructure's reference is PrivateAssets="all" specifically so it
      does not flow transitively into this project; this is a separate,
      equally private reference, not a duplicate to remove.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.18">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\APFlow.Application\APFlow.Application.csproj" />
    <ProjectReference Include="..\APFlow.Infrastructure\APFlow.Infrastructure.csproj" />
    <ProjectReference Include="..\APFlow.Integrations\APFlow.Integrations.csproj" />
    <ProjectReference Include="..\APFlow.Workers\APFlow.Workers.csproj" />
  </ItemGroup>

</Project>
